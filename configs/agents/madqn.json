{
    "name": "MaDQN",
    "hidden_dim": 256,
    "num_hidden_layers": 2,
    "weight_init": "orthogonal",
    "learning_rate": 0.0001,
    "batch_size": 2048,
    "buffer_size": 300000,
    "gamma": 0.99,
    "epsilon_start": 0.99,
    "epsilon_end": 0.01,
    "epsilon_decay_method": "exponential",
    "epsilon_decay_steps": 200000,
    "train_start_size": 1000,
    "train_freq": 1,
    "utd": 1,
    "update_method": "soft",
    "soft_update_tau": 0.05,
    "target_update_interval": 1,
    "clip_grad_norm": 0.5,
    "use_layer_norm": true,
    "device": "auto",
    "inference_device": "cpu",
    "inference_sync_interval": 64,
    "delay_norm": 100.0,
    "cost_limit": 10.0
}
